# Copy to .env, fill in, and restart the app. Never commit .env.

# --- General ---------------------------------------------------------------
RIA_DATA_DIR=./data
RIA_MAX_UPLOAD_MB=20
RIA_MAX_SEGMENT_CHARS=1200
RIA_CHUNK_TOKEN_BUDGET=3000          # use ~1500 for small local models
RIA_TRANSCRIPT_OVERLAP=2
RIA_DEFAULT_PROVIDER=mock            # mock | grok | ollama | openai_compatible
RIA_EVIDENCE_THRESHOLD=85            # % match needed for an evidence quote to count as verified
RIA_MAX_GROUP_STATEMENTS=30          # statements per requirement-synthesis call
RIA_REQUEST_TIMEOUT=180              # seconds
RIA_MIN_SECONDS_BETWEEN_CALLS=0      # raise (e.g. 5) if you hit rate limits
RIA_MAX_PARALLEL_CALLS=1             # e.g. 4 for Grok to speed up large documents; keep 1 for Ollama
RIA_ANALYSIS_DEPTH=deep              # deep (recommended) | quick (fewer AI calls, for tight free-tier limits)
RIA_LOG_LEVEL=INFO                   # DEBUG for troubleshooting; logs are in <RIA_DATA_DIR>/logs/

# --- Grok / xAI -------------------------------------------------------------
# Create an xAI key at console.x.ai (starts with xai-...). Models: grok-2-latest, grok-beta, etc.
# Note: If you enter a Groq Cloud key (starts with 'gsk_'), RIA will auto-route to Groq API.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# --- Ollama (free, local; data stays on your PC) -------------------------------
# Install from ollama.com, then e.g.:  ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Any OpenAI-compatible endpoint (Groq, Azure AI Foundry, OpenRouter, LM Studio …) --
# For Groq Cloud:
#   OPENAI_COMPAT_API_KEY=gsk_...
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b (or llama-3.3-70b-versatile)
# Base URL must end before /chat/completions, e.g. https://openrouter.ai/api/v1
# Note: GitHub Models was retired by GitHub in July 2026.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# --- Jira (direct story creation) ------------------------------------------------
# Only connect to a Jira project your organisation allows. Keep JIRA_SIMULATION=true for demos.
# Cloud: JIRA_BASE_URL=https://your-site.atlassian.net, JIRA_USER_EMAIL + API token (id.atlassian.com).
# Data Center / Server: leave JIRA_USER_EMAIL empty and put a Personal Access Token in JIRA_API_TOKEN.
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Story
JIRA_SIMULATION=true
